# ─── Required ───────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/small_joy"
# 32+ random chars: openssl rand -base64 48
BETTER_AUTH_SECRET=""
# Public URL of the site (used for links, SEO, auth callbacks)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
BETTER_AUTH_URL="http://localhost:3000"

# ─── Payments ───────────────────────────────────────────────
# Only "mock" exists today (DEVELOPMENT SANDBOX – no real money is charged).
# A real Israeli provider adapter must be added before accepting payments. See docs/PAYMENTS.md.
PAYMENT_PROVIDER="mock"
MOCK_PAYMENT_WEBHOOK_SECRET="change-me-long-random-string"
# The sandbox is refused in production unless this is "true" (staging only!)
PAYMENTS_ALLOW_SANDBOX="false"

# ─── Image storage ──────────────────────────────────────────
# "local" writes to public/uploads (development only). Use "s3" in production.
STORAGE_DRIVER="local"
# Any S3-compatible service: Cloudflare R2, AWS S3, MinIO...
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Public base URL serving the bucket, e.g. https://media.example.co.il
S3_PUBLIC_URL=""

# ─── Email (password reset) ─────────────────────────────────
# Without SMTP, emails are printed to the server log in development.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="שמחות קטנות <no-reply@example.co.il>"

# ─── Seeding ────────────────────────────────────────────────
# Set to "false" in production to seed only base data (no demo catalog).
SEED_DEMO="true"
